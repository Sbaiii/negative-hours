# Secrets
.env

# Data (pulled by the pipeline, never committed)
data/raw/
data/processed/
*.duckdb
*.duckdb.wal
*.parquet

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# dbt
warehouse/target/
warehouse/dbt_packages/
warehouse/logs/

# OS / editors
.DS_Store
.vscode/*
!.vscode/extensions.json

# Obsidian: keep the vault config, ignore personal UI state
control-room/.obsidian/workspace*.json
control-room/.obsidian/graph.json
control-room/.obsidian/cache
control-room/.trash/

# dbt writes an anonymous user id next to profiles.yml
warehouse/.user.yml
